# ===== LLM =====
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Embedding =====
EMBED_MODE=local
EMBED_MODEL=all-MiniLM-L6-v2

# ===== HuggingFace mirror (required in mainland China) =====
HF_ENDPOINT=https://hf-mirror.com

# ===== Vector store backend: simple | milvus | pgvector =====
VECTOR_STORE=simple
# 可选：VECTOR_DIM=0 表示从 embedding 模型自动探测维度（一般无需设置）
VECTOR_DIM=0

# ----- Milvus -----
# MILVUS_MODE: local（milvus-lite 本地文件，免 Docker）/ remote（连接 Milvus 服务）
MILVUS_MODE=local
# remote 模式使用的服务地址（MILVUS_MODE=remote 时生效）
MILVUS_URI=http://localhost:19530
# local 模式的本地数据文件路径（MILVUS_MODE=local 时生效）
MILVUS_LITE_PATH=storage/milvus.db
MILVUS_COLLECTION=resume_agent_kb
MILVUS_METRIC=COSINE
MILVUS_TOKEN=

# ----- pgvector（PGVectorStore 默认使用 cosine 距离）-----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=resume_agent
PG_USER=postgres
PG_PASSWORD=postgres
PG_TABLE=resume_agent_kb
PG_SCHEMA=public
# 是否用 JSONB 存 metadata / 是否创建 HNSW 索引
PG_USE_JSONB=true
PG_HNSW=true

# ===== Retrieval / metric =====
# RETRIEVER_MODE: auto | keyword | vector
#   auto    = 尝试向量，失败自动降级到关键词（默认）
#   keyword = 强制 TF-IDF 关键词检索，零网络依赖，开箱即跑通
#   vector  = 强制向量检索（需要能下载 HuggingFace 模型 / 连上向量库）
RETRIEVER_MODE=auto
TOP_K=5
RECALL_TARGET=0.85
